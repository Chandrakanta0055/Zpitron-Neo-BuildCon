<!-- Sticky Navigation Bar -->
<header id="main-navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#0D1B2A]/90 backdrop-blur-md border-b border-amber-500/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
            <!-- Brand Logo -->
            <a href="/" class="flex items-center space-x-3 group">
                <img src="/images/logo/emblem.jpg" alt="ZIPTRON Logo" class="w-12 h-12 rounded-xl object-contain bg-black p-1 border border-amber-500/30 group-hover:border-amber-400 transition-all duration-300 shadow-[0_0_15px_rgba(245,166,35,0.2)]">
                <div class="flex flex-col">
                    <span class="font-outfit font-black text-xl md:text-2xl tracking-wider text-white group-hover:text-amber-400 transition-colors">
                        ZIPTRON
                    </span>
                    <span class="text-[10px] tracking-[0.25em] uppercase font-bold text-amber-400">
                        NEO BUILDCON
                    </span>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
                <a href="/" class="nav-link px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= typeof page !== 'undefined' && page === 'home' ? 'text-amber-400 font-semibold' : 'text-slate-300 hover:text-white' %>">
                    Home
                </a>
                <a href="/about" class="nav-link px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= typeof page !== 'undefined' && page === 'about' ? 'text-amber-400 font-semibold' : 'text-slate-300 hover:text-white' %>">
                    About Us
                </a>
                <a href="/projects" class="nav-link px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= typeof page !== 'undefined' && page === 'projects' ? 'text-amber-400 font-semibold' : 'text-slate-300 hover:text-white' %>">
                    Projects
                </a>
                <a href="/team" class="nav-link px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= typeof page !== 'undefined' && page === 'team' ? 'text-amber-400 font-semibold' : 'text-slate-300 hover:text-white' %>">
                    Team & Leadership
                </a>
                <a href="/contact" class="nav-link px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= typeof page !== 'undefined' && page === 'contact' ? 'text-amber-400 font-semibold' : 'text-slate-300 hover:text-white' %>">
                    Contact Us
                </a>
            </nav>

            <!-- CTA Call Button -->
            <div class="hidden md:flex items-center space-x-4">
                <a href="tel:+919337512111" class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-full bg-gradient-to-r from-amber-500 to-amber-600 text-black font-semibold text-sm hover:from-amber-400 hover:to-amber-500 transition-all duration-300 shadow-[0_0_20px_rgba(245,166,35,0.3)] hover:shadow-[0_0_25px_rgba(245,166,35,0.5)] transform hover:-translate-y-0.5">
                    <i class="fa-solid fa-phone text-xs"></i>
                    <span>+91 9337512111</span>
                </a>
            </div>

            <!-- Mobile Menu Button -->
            <div class="flex md:hidden">
                <button id="mobile-menu-btn" type="button" class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 focus:outline-none" aria-label="Toggle Navigation">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Drawer -->
    <div id="mobile-menu" class="hidden md:hidden bg-[#0D1B2A]/98 border-b border-amber-500/20 px-4 pt-2 pb-6 space-y-2">
        <a href="/" class="block px-3 py-2 rounded-lg text-base font-medium <%= typeof page !== 'undefined' && page === 'home' ? 'bg-amber-500/20 text-amber-400' : 'text-slate-300 hover:bg-slate-800' %>">Home</a>
        <a href="/about" class="block px-3 py-2 rounded-lg text-base font-medium <%= typeof page !== 'undefined' && page === 'about' ? 'bg-amber-500/20 text-amber-400' : 'text-slate-300 hover:bg-slate-800' %>">About Us</a>
        <a href="/projects" class="block px-3 py-2 rounded-lg text-base font-medium <%= typeof page !== 'undefined' && page === 'projects' ? 'bg-amber-500/20 text-amber-400' : 'text-slate-300 hover:bg-slate-800' %>">Projects</a>
        <a href="/team" class="block px-3 py-2 rounded-lg text-base font-medium <%= typeof page !== 'undefined' && page === 'team' ? 'bg-amber-500/20 text-amber-400' : 'text-slate-300 hover:bg-slate-800' %>">Team & Leadership</a>
        <a href="/contact" class="block px-3 py-2 rounded-lg text-base font-medium <%= typeof page !== 'undefined' && page === 'contact' ? 'bg-amber-500/20 text-amber-400' : 'text-slate-300 hover:bg-slate-800' %>">Contact Us</a>
        <div class="pt-4 border-t border-slate-800">
            <a href="tel:+919337512111" class="flex items-center justify-center space-x-2 w-full py-3 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 text-black font-bold">
                <i class="fa-solid fa-phone"></i>
                <span>Call Now: +91 9337512111</span>
            </a>
        </div>
    </div>
</header>
<!-- Spacing element for fixed header -->
<div class="h-20"></div>
