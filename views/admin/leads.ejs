<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-xs font-bold mb-2">
                <i class="fa-solid fa-inbox"></i>
                <span>Direct Client Inquiries</span>
            </div>
            <h2 class="text-3xl font-outfit font-black text-white">Client Inquiry Inbox</h2>
            <p class="text-xs text-slate-400">Manage real-time messages submitted from the public Contact page and project booking forms.</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold">
                Total Leads: <%= totalCount %>
            </span>
            <span class="px-3 py-1.5 rounded-xl bg-sky-500/10 border border-sky-500/30 text-sky-400 text-xs font-bold">
                New: <%= newCount %>
            </span>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="flex flex-wrap items-center gap-2 pb-2">
        <a href="/admin/leads" class="px-4 py-2 rounded-xl text-xs font-bold transition-all <%= filterStatus === 'all' ? 'bg-amber-500 text-black shadow-lg shadow-amber-500/20' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800' %>">
            All Inquiries (<%= totalCount %>)
        </a>
        <a href="/admin/leads?status=new" class="px-4 py-2 rounded-xl text-xs font-bold transition-all <%= filterStatus === 'new' ? 'bg-sky-500 text-white shadow-lg shadow-sky-500/20' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800' %>">
            🔵 New / Unread (<%= newCount %>)
        </a>
        <a href="/admin/leads?status=contacted" class="px-4 py-2 rounded-xl text-xs font-bold transition-all <%= filterStatus === 'contacted' ? 'bg-amber-500/30 text-amber-300 border border-amber-500/40' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800' %>">
            🟡 Contacted (<%= contactedCount %>)
        </a>
        <a href="/admin/leads?status=closed" class="px-4 py-2 rounded-xl text-xs font-bold transition-all <%= filterStatus === 'closed' ? 'bg-emerald-500 text-white shadow-lg shadow-emerald-500/20' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800' %>">
            🟢 Closed / Won (<%= closedCount %>)
        </a>
    </div>

    <!-- Leads List -->
    <% if (leads && leads.length > 0) { %>
        <div class="space-y-4">
            <% leads.forEach(lead => { %>
                <div class="bg-[#0D1B2A] p-6 rounded-2xl border <%= lead.status === 'new' ? 'border-sky-500/50 shadow-lg shadow-sky-500/5' : 'border-slate-800' %> space-y-4 transition-all">
                    <!-- Top row: Status & Date -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-800/80">
                        <div class="flex items-center gap-3">
                            <% if (lead.status === 'new') { %>
                                <span class="px-2.5 py-1 rounded-full bg-sky-500/20 text-sky-400 border border-sky-500/40 text-[10px] font-bold uppercase tracking-wider flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-ping"></span>
                                    New Inquiry
                                </span>
                            <% } else if (lead.status === 'contacted') { %>
                                <span class="px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/40 text-[10px] font-bold uppercase tracking-wider">
                                    🟡 Contacted
                                </span>
                            <% } else { %>
                                <span class="px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 text-[10px] font-bold uppercase tracking-wider">
                                    🟢 Closed
                                </span>
                            <% } %>

                            <span class="text-xs text-amber-400 font-semibold bg-amber-500/10 px-2.5 py-0.5 rounded-lg border border-amber-500/20">
                                <%= lead.service || 'General Inquiry' %>
                            </span>
                            <% if (lead.project_name) { %>
                                <span class="text-xs text-slate-300 font-medium bg-slate-800 px-2 py-0.5 rounded-lg">
                                    Project: <strong class="text-white"><%= lead.project_name %></strong>
                                </span>
                            <% } %>
                        </div>

                        <span class="text-[11px] text-slate-500 font-mono">
                            <%= new Date(lead.created_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'medium', timeStyle: 'short' }) %>
                        </span>
                    </div>

                    <!-- Client Info & Message -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <!-- Contact Info -->
                        <div class="space-y-2 text-xs">
                            <div>
                                <span class="text-slate-500 block text-[10px] uppercase font-bold">Client Name</span>
                                <strong class="text-base font-outfit text-white"><%= lead.name %></strong>
                            </div>
                            <div class="space-y-1 pt-1">
                                <p class="text-slate-300 flex items-center gap-2">
                                    <i class="fa-solid fa-phone text-amber-400 w-4"></i>
                                    <a href="tel:<%= lead.phone %>" class="hover:text-amber-400 font-mono transition-colors"><%= lead.phone %></a>
                                </p>
                                <% if (lead.email) { %>
                                    <p class="text-slate-300 flex items-center gap-2">
                                        <i class="fa-solid fa-envelope text-amber-400 w-4"></i>
                                        <a href="mailto:<%= lead.email %>" class="hover:text-amber-400 transition-colors"><%= lead.email %></a>
                                    </p>
                                <% } %>
                            </div>
                        </div>

                        <!-- Message Content -->
                        <div class="lg:col-span-2 p-4 rounded-xl bg-slate-900/80 border border-slate-800 space-y-1">
                            <span class="text-[10px] text-slate-500 uppercase font-bold block">Inquiry Message:</span>
                            <p class="text-xs text-slate-200 leading-relaxed"><%= lead.message %></p>
                        </div>
                    </div>

                    <!-- Actions Bar -->
                    <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-800 text-xs">
                        <div class="flex items-center gap-2">
                            <% if (lead.phone) { %>
                                <a href="tel:<%= lead.phone %>" class="px-3 py-1.5 rounded-lg bg-sky-500/20 text-sky-400 hover:bg-sky-500/30 border border-sky-500/30 font-bold transition-all flex items-center gap-1.5">
                                    <i class="fa-solid fa-phone text-xs"></i>
                                    <span>Call</span>
                                </a>
                                <% 
                                    const cleanPhone = lead.phone.replace(/[^0-9]/g, '');
                                    const waNumber = cleanPhone.length === 10 ? '91' + cleanPhone : cleanPhone;
                                %>
                                <a href="https://wa.me/<%= waNumber %>?text=Hello%20<%= encodeURIComponent(lead.name) %>,%20thank%20you%20for%20contacting%20ZIPTRON%20NEO%20BUILDCON." target="_blank" class="px-3 py-1.5 rounded-lg bg-emerald-500/20 text-emerald-400 hover:bg-emerald-500/30 border border-emerald-500/30 font-bold transition-all flex items-center gap-1.5">
                                    <i class="fa-brands fa-whatsapp text-xs"></i>
                                    <span>WhatsApp</span>
                                </a>
                            <% } %>
                        </div>

                        <!-- Change Status & Delete -->
                        <div class="flex items-center gap-2">
                            <form action="/admin/leads/<%= lead.id %>/status" method="POST" class="flex items-center gap-1.5">
                                <label class="text-[11px] text-slate-500">Status:</label>
                                <select name="status" onchange="this.form.submit()" class="px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-700 text-xs text-white focus:border-amber-400 focus:outline-none">
                                    <option value="new" <%= lead.status === 'new' ? 'selected' : '' %>>🔵 New</option>
                                    <option value="contacted" <%= lead.status === 'contacted' ? 'selected' : '' %>>🟡 Contacted</option>
                                    <option value="closed" <%= lead.status === 'closed' ? 'selected' : '' %>>🟢 Closed</option>
                                </select>
                            </form>

                            <form action="/admin/leads/<%= lead.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this lead record?');">
                                <button type="submit" title="Delete Inquiry" class="p-1.5 rounded-lg text-slate-500 hover:text-red-400 hover:bg-red-500/10 transition-colors">
                                    <i class="fa-solid fa-trash text-xs"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="text-center py-16 bg-[#0D1B2A] rounded-2xl border border-slate-800 space-y-3">
            <div class="w-16 h-16 rounded-full bg-slate-800 text-slate-600 mx-auto flex items-center justify-center text-2xl">
                <i class="fa-solid fa-inbox"></i>
            </div>
            <h3 class="text-lg font-outfit font-bold text-white">No inquiries found</h3>
            <p class="text-xs text-slate-400">Inquiries submitted from the Contact page or site visit forms will appear here in real-time.</p>
        </div>
    <% } %>
</div>
