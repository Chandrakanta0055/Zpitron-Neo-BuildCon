<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/30 text-xs font-bold mb-2">
                <i class="fa-solid fa-chart-simple"></i>
                <span>Live Metrics & Parameters</span>
            </div>
            <h2 class="text-3xl font-outfit font-black text-white">Live Stats & Settings</h2>
            <p class="text-xs text-slate-400">Update homepage live counter numbers, corporate contact info, and slogan in real-time.</p>
        </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="p-4 rounded-2xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-xs flex items-center gap-3 shadow-lg shadow-emerald-500/5">
            <i class="fa-solid fa-circle-check text-emerald-400 text-base"></i>
            <span><strong>Settings Saved!</strong> The live website has been updated with your new metrics and parameters.</span>
        </div>
    <% } %>

    <!-- Settings Form -->
    <div class="bg-[#0D1B2A] p-8 rounded-3xl border border-amber-500/20 shadow-2xl">
        <form action="/admin/stats" method="POST" enctype="multipart/form-data" class="space-y-8">
            
            <!-- Section 1: Live Counter Numbers -->
            <div class="space-y-4">
                <h3 class="text-base font-outfit font-bold text-white border-l-2 border-amber-400 pl-3 uppercase tracking-wider text-xs">
                    Homepage Live Counters
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-400 mb-1.5">Completed Projects</label>
                        <input type="text" name="completed_projects" required value="<%= settings.completed_projects || '11+' %>" 
                               class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-emerald-400 font-bold text-sm focus:border-amber-400 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-400 mb-1.5">Ongoing Projects</label>
                        <input type="text" name="ongoing_projects" required value="<%= settings.ongoing_projects || '6+' %>" 
                               class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sky-400 font-bold text-sm focus:border-amber-400 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-400 mb-1.5">Heavy Machinery Fleet</label>
                        <input type="text" name="machinery_fleet" required value="<%= settings.machinery_fleet || '400+' %>" 
                               class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-amber-400 font-bold text-sm focus:border-amber-400 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-400 mb-1.5">Years of Growth</label>
                        <input type="text" name="years_growth" required value="<%= settings.years_growth || '3+' %>" 
                               class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white font-bold text-sm focus:border-amber-400 focus:outline-none">
                    </div>
                </div>
            </div>

            <!-- Section 2: Hero Background Image -->
            <div class="space-y-4 pt-4 border-t border-slate-800">
                <div class="flex items-center justify-between">
                    <h3 class="text-base font-outfit font-bold text-white border-l-2 border-amber-400 pl-3 uppercase tracking-wider text-xs">
                        Homepage Hero Background Image
                    </h3>
                    <span class="text-[10px] text-slate-400 font-mono">Recommended: 1920x1080 (JPG, PNG, WebP)</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
                    <!-- Current Preview -->
                    <div class="space-y-2">
                        <span class="block text-[11px] font-semibold text-slate-400">Current Hero Background:</span>
                        <div class="relative w-full h-36 rounded-2xl overflow-hidden border border-slate-700 bg-slate-950 group">
                            <img src="<%= settings.hero_background_image || '/images/hero/hero_bg.jpg' %>" 
                                 alt="Current Hero Background" 
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-3">
                                <span class="text-[10px] text-amber-400 font-mono font-bold">Active on Live Website</span>
                            </div>
                        </div>
                    </div>

                    <!-- Upload Controls -->
                    <div class="space-y-3">
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-400 mb-1.5">
                                Upload New Background Image
                            </label>
                            <input type="file" name="hero_background_image" accept="image/*" 
                                   class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-slate-300 text-xs focus:border-amber-400 focus:outline-none file:mr-4 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-amber-500 file:text-slate-950 hover:file:bg-amber-400">
                        </div>

                        <div class="pt-1 flex items-center gap-2">
                            <input type="checkbox" name="reset_hero_bg" value="1" id="reset_hero_bg" 
                                   class="rounded border-slate-700 text-amber-500 focus:ring-amber-400">
                            <label for="reset_hero_bg" class="text-xs text-slate-400 hover:text-slate-200 cursor-pointer">
                                Reset to Default Background Image
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Branding & Slogan -->
            <div class="space-y-4 pt-4 border-t border-slate-800">
                <h3 class="text-base font-outfit font-bold text-white border-l-2 border-amber-400 pl-3 uppercase tracking-wider text-xs">
                    Branding Slogan / Tagline
                </h3>
                <div>
                    <label class="block text-[11px] font-semibold text-slate-400 mb-1.5">Corporate Tagline</label>
                    <input type="text" name="tagline" required value="<%= settings.tagline || 'Build your Thinking' %>" 
                           class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:border-amber-400 focus:outline-none">
                </div>
            </div>

            <!-- Section 4: Official Contact Numbers & Emails -->
            <div class="space-y-4 pt-4 border-t border-slate-800">
                <h3 class="text-base font-outfit font-bold text-white border-l-2 border-amber-400 pl-3 uppercase tracking-wider text-xs">
                    Official Contact Channels
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-400 mb-1.5">Primary Phone</label>
                        <input type="text" name="primary_phone" required value="<%= settings.primary_phone || '+91 9337512111' %>" 
                               class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:border-amber-400 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-400 mb-1.5">Secondary Phone</label>
                        <input type="text" name="secondary_phone" value="<%= settings.secondary_phone || '+91 7008757918' %>" 
                               class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:border-amber-400 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-400 mb-1.5">Corporate Email</label>
                        <input type="email" name="email" required value="<%= settings.email || 'info@ziptron.co.in' %>" 
                               class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:border-amber-400 focus:outline-none">
                    </div>
                </div>
            </div>

            <!-- Section 5: Corporate Headquarters Address -->
            <div class="space-y-4 pt-4 border-t border-slate-800">
                <h3 class="text-base font-outfit font-bold text-white border-l-2 border-amber-400 pl-3 uppercase tracking-wider text-xs">
                    Corporate Headquarters Address
                </h3>
                <div>
                    <label class="block text-[11px] font-semibold text-slate-400 mb-1.5">Bhubaneswar Corporate HQ (Odisha)</label>
                    <textarea name="corporate_office" rows="2" 
                              class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none"><%= settings.corporate_office || 'Ziptron House, Plot No. 952/3735, Stadium Lane, Nayapalli, Bhubaneswar, Khordha, Odisha – 751012, India.' %></textarea>
                </div>
            </div>

            <!-- Submit -->
            <div class="pt-6 border-t border-slate-800 flex justify-end">
                <button type="submit" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-400 text-black font-outfit font-black text-xs hover:from-amber-400 hover:to-amber-300 transition-all shadow-xl shadow-amber-500/20 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-check"></i>
                    <span>Save Live Settings</span>
                </button>
            </div>
        </form>
    </div>
</div>
