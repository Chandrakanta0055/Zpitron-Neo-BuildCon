<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Portal Login | ZIPTRON NEO BUILDCON</title>
    <link rel="icon" type="image/jpeg" href="/images/logo/emblem.jpg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            dark: '#0D1B2A',
                            forest: '#05170A',
                            gold: '#F5A623',
                            goldLight: '#ECC246',
                            goldDark: '#D4AF37',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        outfit: ['Outfit', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/animations.css">
</head>
<body class="bg-[#05170A] text-slate-100 min-h-screen flex items-center justify-center p-4 relative overflow-hidden font-sans">
    <!-- Ambient Background Glow -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_30%,rgba(245,166,35,0.15),transparent_60%)] pointer-events-none"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:3rem_3rem] pointer-events-none"></div>

    <div class="max-w-md w-full relative z-10">
        <div class="bg-[#0D1B2A]/90 p-8 sm:p-10 rounded-3xl border border-amber-500/30 shadow-[0_0_50px_rgba(0,0,0,0.8)] backdrop-blur-2xl space-y-6">
            
            <!-- Brand Header -->
            <div class="text-center space-y-3">
                <div class="inline-block p-2 rounded-2xl bg-black border border-amber-500/40 shadow-lg shadow-amber-500/10">
                    <img src="/images/logo/emblem.jpg" alt="ZIPTRON Logo" class="w-16 h-16 object-contain rounded-xl">
                </div>
                <div>
                    <h1 class="text-2xl sm:text-3xl font-outfit font-black text-white tracking-wide">ZIPTRON ADMIN</h1>
                    <p class="text-xs text-amber-400 font-bold uppercase tracking-widest mt-1">Management Portal • CIN: ABA-4283</p>
                </div>
            </div>

            <!-- Error Banner -->
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="p-3.5 rounded-xl bg-red-500/15 border border-red-500/40 text-red-300 text-xs flex items-center gap-2.5">
                    <i class="fa-solid fa-circle-exclamation text-red-400 text-base shrink-0"></i>
                    <span>Invalid admin credentials. Please enter valid email and password.</span>
                </div>
            <% } %>

            <!-- Login Form -->
            <form action="/admin/login" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center justify-between">
                        <span>Admin Email</span>
                        <span class="text-[10px] text-amber-400/80">Corporate Access</span>
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-500 text-sm">
                            <i class="fa-solid fa-envelope"></i>
                        </span>
                        <input type="email" name="email" required placeholder="admin@ziptron.co.in" 
                               class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-900/90 border border-slate-700 text-white text-sm focus:border-amber-400 focus:ring-1 focus:ring-amber-400 focus:outline-none transition-all placeholder-slate-500">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center justify-between">
                        <span>Master Password</span>
                        <span class="text-[10px] text-slate-500">Encrypted</span>
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-500 text-sm">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                        <input type="password" name="password" required placeholder="••••••••••••" 
                               class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-900/90 border border-slate-700 text-white text-sm focus:border-amber-400 focus:ring-1 focus:ring-amber-400 focus:outline-none transition-all placeholder-slate-500">
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500 text-black font-outfit font-black text-sm hover:from-amber-400 hover:to-amber-300 transition-all shadow-xl shadow-amber-500/20 hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Secure Admin Login</span>
                    </button>
                </div>
            </form>
            
            <!-- Quick Helper / Demo Credentials -->
            <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800 text-[11px] text-slate-400 space-y-1">
                <div class="flex justify-between">
                    <span class="text-slate-500">Default Email:</span>
                    <span class="font-mono text-amber-400">admin@ziptron.co.in</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-500">Default Password:</span>
                    <span class="font-mono text-amber-400">Ziptron@2026</span>
                </div>
            </div>

            <div class="text-center pt-1">
                <a href="/" class="text-xs text-slate-400 hover:text-amber-400 transition-colors inline-flex items-center gap-1.5">
                    <i class="fa-solid fa-arrow-left text-[10px]"></i>
                    <span>Return to Public Website</span>
                </a>
            </div>
        </div>
    </div>
</body>
</html>
