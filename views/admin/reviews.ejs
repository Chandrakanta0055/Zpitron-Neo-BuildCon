<!-- Admin Customer Feedback & Reviews Management -->
<div class="space-y-8">
    <!-- Top Action Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-heading font-bold text-white flex items-center gap-3">
                <span class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 text-lg">
                    <i class="fa-solid fa-star"></i>
                </span>
                <span>Customer Reviews & Feedback</span>
            </h1>
            <p class="text-xs sm:text-sm text-slate-400 mt-1">
                Manage live customer feedback, star ratings, and best wishes displayed on the public website.
            </p>
        </div>

        <button type="button" onclick="openAdminAddReviewModal()" class="px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs sm:text-sm uppercase tracking-wider transition-all flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20">
            <i class="fa-solid fa-plus"></i>
            <span>Add Verified Review</span>
        </button>
    </div>

    <!-- Alert Notifications -->
    <% if (typeof query !== 'undefined' && query.success) { %>
        <div class="p-4 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-semibold flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
                <span>Review updated successfully!</span>
            </div>
            <a href="/admin/reviews" class="text-emerald-400 hover:underline">Dismiss</a>
        </div>
    <% } %>

    <!-- Metric Counter Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="glass-card p-5">
            <div class="flex items-center justify-between">
                <span class="text-xs text-slate-400 font-bold uppercase tracking-wider">Total Feedback</span>
                <i class="fa-solid fa-comments text-amber-400 text-lg"></i>
            </div>
            <p class="text-3xl font-heading font-bold text-white mt-2"><%= totalCount %></p>
        </div>

        <div class="glass-card p-5">
            <div class="flex items-center justify-between">
                <span class="text-xs text-emerald-400 font-bold uppercase tracking-wider">Approved & Live</span>
                <i class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
            </div>
            <p class="text-3xl font-heading font-bold text-emerald-400 mt-2"><%= approvedCount %></p>
        </div>

        <div class="glass-card p-5">
            <div class="flex items-center justify-between">
                <span class="text-xs text-amber-400 font-bold uppercase tracking-wider">Pending Moderation</span>
                <i class="fa-solid fa-clock text-amber-400 text-lg"></i>
            </div>
            <p class="text-3xl font-heading font-bold text-amber-400 mt-2"><%= pendingCount %></p>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="flex flex-wrap items-center gap-2 border-b border-slate-800 pb-3">
        <a href="/admin/reviews?filter=all" class="px-4 py-1.5 rounded-lg text-xs font-bold transition-all <%= filter === 'all' ? 'bg-amber-500 text-slate-950' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800' %>">
            All Reviews (<%= totalCount %>)
        </a>
        <a href="/admin/reviews?filter=approved" class="px-4 py-1.5 rounded-lg text-xs font-bold transition-all <%= filter === 'approved' ? 'bg-emerald-500 text-slate-950' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800' %>">
            Approved (<%= approvedCount %>)
        </a>
        <a href="/admin/reviews?filter=pending" class="px-4 py-1.5 rounded-lg text-xs font-bold transition-all <%= filter === 'pending' ? 'bg-amber-500 text-slate-950' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800' %>">
            Pending (<%= pendingCount %>)
        </a>
    </div>

    <!-- Reviews Content List -->
    <% if (testimonials && testimonials.length > 0) { %>
        <!-- Desktop Table View -->
        <div class="hidden lg:block glass-card overflow-hidden">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-900/80 text-slate-400 uppercase font-bold text-[11px] border-b border-slate-800">
                    <tr>
                        <th class="p-4">Customer</th>
                        <th class="p-4">Project / Sector</th>
                        <th class="p-4">Rating</th>
                        <th class="p-4">Review & Wishes</th>
                        <th class="p-4">Status</th>
                        <th class="p-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60">
                    <% testimonials.forEach(t => { %>
                        <tr class="hover:bg-slate-800/30 transition-colors">
                            <td class="p-4">
                                <strong class="text-white block font-bold text-sm"><%= t.name %></strong>
                                <span class="text-slate-400 text-[11px]"><%= t.role_or_city || 'Valued Client' %></span>
                            </td>
                            <td class="p-4">
                                <span class="px-2.5 py-1 rounded-md bg-slate-900 border border-slate-700 text-amber-400 font-bold text-[10px] uppercase">
                                    <%= t.project_name || 'General' %>
                                </span>
                            </td>
                            <td class="p-4">
                                <div class="flex text-amber-400 text-xs gap-0.5">
                                    <% for(let s = 1; s <= 5; s++) { %>
                                        <i class="fa-solid fa-star <%= s <= (t.rating || 5) ? 'text-amber-400' : 'text-slate-700' %>"></i>
                                    <% } %>
                                </div>
                            </td>
                            <td class="p-4 max-w-xs xl:max-w-md text-slate-300 leading-relaxed">
                                "<%= t.message %>"
                            </td>
                            <td class="p-4">
                                <% if (t.is_approved) { %>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-bold text-[10px] uppercase">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Live
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-400 font-bold text-[10px] uppercase">
                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Pending
                                    </span>
                                <% } %>
                            </td>
                            <td class="p-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <form action="/admin/reviews/<%= t.id %>/toggle" method="POST" class="inline">
                                        <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-colors <%= t.is_approved ? 'bg-slate-800 text-slate-300 hover:bg-slate-700' : 'bg-emerald-500 hover:bg-emerald-400 text-slate-950' %>">
                                            <%= t.is_approved ? 'Hide' : 'Approve' %>
                                        </button>
                                    </form>
                                    <form action="/admin/reviews/<%= t.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this feedback?');" class="inline">
                                        <button type="submit" class="p-1.5 rounded-lg bg-red-500/10 hover:bg-red-500/25 text-red-400 transition-colors">
                                            <i class="fa-solid fa-trash text-xs"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <!-- Mobile Card List View -->
        <div class="lg:hidden space-y-4">
            <% testimonials.forEach(t => { %>
                <div class="glass-card p-5 space-y-4">
                    <div class="flex items-start justify-between">
                        <div>
                            <h3 class="text-white font-bold text-base"><%= t.name %></h3>
                            <p class="text-xs text-slate-400"><%= t.role_or_city || 'Valued Client' %></p>
                        </div>
                        <% if (t.is_approved) { %>
                            <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-bold text-[10px] uppercase">
                                Live
                            </span>
                        <% } else { %>
                            <span class="px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-400 font-bold text-[10px] uppercase">
                                Pending
                            </span>
                        <% } %>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="flex text-amber-400 text-xs gap-0.5">
                            <% for(let s = 1; s <= 5; s++) { %>
                                <i class="fa-solid fa-star <%= s <= (t.rating || 5) ? 'text-amber-400' : 'text-slate-700' %>"></i>
                            <% } %>
                        </div>
                        <span class="px-2 py-0.5 rounded bg-slate-900 text-amber-400 text-[10px] font-bold">
                            <%= t.project_name || 'General' %>
                        </span>
                    </div>

                    <p class="text-xs text-slate-300 italic bg-slate-900/60 p-3 rounded-xl border border-slate-800 leading-relaxed">
                        "<%= t.message %>"
                    </p>

                    <div class="pt-2 flex items-center justify-end gap-2 border-t border-slate-800/80">
                        <form action="/admin/reviews/<%= t.id %>/toggle" method="POST" class="inline">
                            <button type="submit" class="px-4 py-2 rounded-xl text-xs font-bold transition-all <%= t.is_approved ? 'bg-slate-800 text-slate-300' : 'bg-emerald-500 text-slate-950' %>">
                                <%= t.is_approved ? 'Hide from Website' : 'Approve & Publish' %>
                            </button>
                        </form>
                        <form action="/admin/reviews/<%= t.id %>/delete" method="POST" onsubmit="return confirm('Delete this feedback?');" class="inline">
                            <button type="submit" class="p-2 rounded-xl bg-red-500/10 text-red-400 hover:bg-red-500/20">
                                <i class="fa-solid fa-trash text-xs"></i>
                            </button>
                        </form>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="glass-card p-12 text-center space-y-3">
            <i class="fa-solid fa-star-half-stroke text-amber-400 text-4xl"></i>
            <h3 class="text-lg font-heading font-bold text-white">No reviews found in this filter</h3>
            <p class="text-xs text-slate-400 max-w-sm mx-auto">
                Customer feedback submitted on the home page will appear here for review and verification.
            </p>
        </div>
    <% } %>
</div>

<!-- Add Verified Review Modal (Admin) -->
<div id="adminReviewModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden">
    <div class="relative w-full max-w-lg rounded-2xl bg-[#0D1B2A] border border-amber-500/30 p-6 sm:p-8 space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <h3 class="text-lg font-heading font-bold text-white">Add Verified Client Review</h3>
            <button type="button" onclick="closeAdminAddReviewModal()" class="text-slate-400 hover:text-white">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form action="/admin/reviews/new" method="POST" class="space-y-4 text-xs">
            <div class="space-y-1">
                <label class="font-bold uppercase tracking-wider text-slate-300">Customer Name *</label>
                <input type="text" name="name" required placeholder="e.g. Sanjay Kumar Sahu" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm outline-none focus:border-amber-400">
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1">
                    <label class="font-bold uppercase tracking-wider text-slate-300">Designation / City</label>
                    <input type="text" name="role_or_city" placeholder="e.g. Homeowner, Bhubaneswar" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm outline-none focus:border-amber-400">
                </div>
                <div class="space-y-1">
                    <label class="font-bold uppercase tracking-wider text-slate-300">Rating (1-5)</label>
                    <select name="rating" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm outline-none focus:border-amber-400">
                        <option value="5">⭐⭐⭐⭐⭐ (5 Stars)</option>
                        <option value="4">⭐⭐⭐⭐ (4 Stars)</option>
                        <option value="3">⭐⭐⭐ (3 Stars)</option>
                    </select>
                </div>
            </div>

            <div class="space-y-1">
                <label class="font-bold uppercase tracking-wider text-slate-300">Project / Sector</label>
                <input type="text" name="project_name" placeholder="e.g. ZIPTRON AVANYA" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm outline-none focus:border-amber-400">
            </div>

            <div class="space-y-1">
                <label class="font-bold uppercase tracking-wider text-slate-300">Review & Wishes Message *</label>
                <textarea name="message" required rows="4" placeholder="Client review content..." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm outline-none focus:border-amber-400 resize-none"></textarea>
            </div>

            <div class="flex items-center gap-2 pt-1">
                <input type="checkbox" name="is_approved" id="is_approved" checked class="rounded border-slate-700 text-amber-500 focus:ring-amber-400">
                <label for="is_approved" class="text-slate-300 font-medium">Publish immediately to live website</label>
            </div>

            <div class="pt-3 flex items-center justify-end gap-3">
                <button type="button" onclick="closeAdminAddReviewModal()" class="px-4 py-2 rounded-xl bg-slate-800 text-slate-300 hover:text-white">Cancel</button>
                <button type="submit" class="px-6 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold uppercase tracking-wider">Save Review</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openAdminAddReviewModal() {
        document.getElementById('adminReviewModal').classList.remove('hidden');
    }
    function closeAdminAddReviewModal() {
        document.getElementById('adminReviewModal').classList.add('hidden');
    }
</script>
