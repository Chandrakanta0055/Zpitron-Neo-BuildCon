<!-- ==========================================
     FEATURED FLAGSHIP PROJECTS SECTION (DYNAMIC)
     ========================================== -->
<% if (typeof featuredProjects !== 'undefined' && featuredProjects && featuredProjects.length > 0) { %>
<section class="py-20 px-4 sm:px-6 lg:px-8 bg-[#0D1B2A]">
    <div class="max-w-7xl mx-auto space-y-12">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div data-aos="fade-right" class="space-y-3">
                <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-widest">
                    <i class="fa-solid fa-city"></i>
                    <span>Portfolio Spotlight</span>
                </div>
                <h2 class="text-3xl sm:text-4xl md:text-5xl font-outfit font-black text-white">
                    Featured <span class="text-gold-gradient">Flagship Projects</span>
                </h2>
                <p class="text-slate-300 text-sm max-w-xl">
                    Discover our benchmark residential apartment complexes, commercial developments, and industrial sites.
                </p>
            </div>
            <div data-aos="fade-left">
                <a href="/projects" class="btn-glass text-xs">
                    <span>View All Projects</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <!-- Featured Dynamic Project Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% featuredProjects.forEach((project, idx) => { %>
                <div data-aos="fade-up" data-aos-delay="<%= (idx + 1) * 100 %>" class="glass-card overflow-hidden group flex flex-col justify-between">
                    <div>
                        <!-- Thumbnail Image -->
                        <a href="/projects/<%= project.slug %>" class="block h-56 bg-slate-900 relative overflow-hidden flex items-center justify-center border-b border-slate-800">
                            <% if (project.cover_image && project.cover_image !== '/images/projects/default.jpg') { %>
                                <img src="<%= project.cover_image %>" alt="<%= project.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center text-amber-500/30 text-6xl group-hover:scale-110 transition-transform duration-500">
                                    <% if (project.category === 'mining') { %>
                                        <i class="fa-solid fa-truck-monster"></i>
                                    <% } else if (project.category === 'solar') { %>
                                        <i class="fa-solid fa-solar-panel"></i>
                                    <% } else if (project.category === 'construction') { %>
                                        <i class="fa-solid fa-trowel-bricks"></i>
                                    <% } else { %>
                                        <i class="fa-solid fa-city"></i>
                                    <% } %>
                                </div>
                            <% } %>

                            <div class="absolute top-4 left-4 z-20">
                                <% if (project.status === 'completed') { %>
                                    <span class="badge-completed"><i class="fa-solid fa-check text-[10px]"></i> Completed</span>
                                <% } else { %>
                                    <span class="badge-ongoing"><span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span> Ongoing</span>
                                <% } %>
                            </div>
                            <div class="absolute top-4 right-4 z-20">
                                <span class="px-2.5 py-1 rounded-full bg-black/70 text-amber-400 text-[10px] font-bold border border-amber-500/30 uppercase">
                                    <%= project.category %>
                                </span>
                            </div>
                        </a>

                        <!-- Details -->
                        <div class="p-6 space-y-3">
                            <div class="flex items-center text-xs text-amber-400 gap-1.5">
                                <i class="fa-solid fa-location-dot"></i>
                                <span><%= project.location %></span>
                            </div>
                            <h3 class="text-xl font-outfit font-bold text-white group-hover:text-amber-400 transition-colors">
                                <a href="/projects/<%= project.slug %>"><%= project.title %></a>
                            </h3>
                            <% if (project.short_desc) { %>
                                <p class="text-xs text-slate-300 line-clamp-2">
                                    <%= project.short_desc %>
                                </p>
                            <% } %>
                        </div>
                    </div>

                    <div class="p-6 pt-0">
                        <div class="pt-4 border-t border-slate-800 flex items-center justify-between text-xs">
                            <span class="text-slate-400"><%= project.built_up_area || project.unit_types || 'Flagship EPC' %></span>
                            <a href="/projects/<%= project.slug %>" class="text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1">Photos & Details <i class="fa-solid fa-angle-right"></i></a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

