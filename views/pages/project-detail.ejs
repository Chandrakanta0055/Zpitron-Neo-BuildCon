<!-- ==========================================
     PROJECT DETAIL BANNER
     ========================================== -->
<section class="relative py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-[#05170A] via-[#0D1B2A] to-[#0D1B2A] border-b border-amber-500/10">
    <div class="max-w-7xl mx-auto space-y-4">
        <!-- Breadcrumbs -->
        <nav class="flex items-center space-x-2 text-xs text-slate-400">
            <a href="/" class="hover:text-amber-400">Home</a>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
            <a href="/projects" class="hover:text-amber-400">Projects</a>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
            <span class="text-amber-400 font-semibold truncate"><%= typeof project !== 'undefined' && project ? project.title : 'Project Detail' %></span>
        </nav>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-2">
            <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-wider">
                        <%= typeof project !== 'undefined' && project ? project.category : 'Real Estate' %>
                    </span>
                    <% if (typeof project !== 'undefined' && project && project.status === 'completed') { %>
                        <span class="badge-completed"><i class="fa-solid fa-check text-[10px]"></i> Delivered Milestone</span>
                    <% } else { %>
                        <span class="badge-ongoing"><span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-ping"></span> Active Construction</span>
                    <% } %>
                    <% if (typeof project !== 'undefined' && project && project.video_url) { %>
                        <span class="px-3 py-1 rounded-full bg-red-500/15 border border-red-500/40 text-red-400 text-xs font-bold flex items-center gap-1.5">
                            <i class="fa-solid fa-circle-play animate-pulse"></i> Video Walkthrough Available
                        </span>
                    <% } %>
                </div>
                <h1 class="text-3xl sm:text-5xl font-outfit font-black text-white">
                    <%= typeof project !== 'undefined' && project ? project.title : 'Project Showcase' %>
                </h1>
                <div class="flex items-center text-sm text-slate-300 gap-2">
                    <i class="fa-solid fa-location-dot text-amber-400"></i>
                    <span><%= typeof project !== 'undefined' && project ? project.location : 'Odisha, India' %></span>
                </div>
            </div>

            <!-- Jump to inquiry button -->
            <div class="flex items-center gap-3">
                <% if (typeof project !== 'undefined' && project && project.video_url) { %>
                    <a href="#video-walkthrough-section" class="px-5 py-3 rounded-full bg-red-500/20 text-red-400 border border-red-500/40 hover:bg-red-500/30 font-bold text-xs flex items-center gap-2 transition-all">
                        <i class="fa-solid fa-play"></i> Watch Video Tour
                    </a>
                <% } %>
                <a href="#inquire" class="btn-gold text-xs shadow-xl shadow-amber-500/10">
                    <i class="fa-solid fa-calendar-check mr-1.5"></i>
                    <span>Schedule Site Visit</span>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================
     MAIN PROJECT CONTENT
     ========================================== -->
<section class="py-12 px-4 sm:px-6 lg:px-8 bg-[#0D1B2A]">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-10">

        <!-- Left 2 Columns: Overview, Video Tour & Photo Gallery -->
        <div class="lg:col-span-2 space-y-10">

            <!-- Clean Project Overview & Specifications -->
            <div class="glass-card p-6 sm:p-8 space-y-6">
                <h2 class="text-xl font-outfit font-bold text-white border-l-4 border-amber-400 pl-3">
                    Project Overview & Details
                </h2>

                <!-- Key Parameters Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                    <div class="bg-slate-900/80 p-4 rounded-xl border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-400 block uppercase font-bold">Industry Sector</span>
                        <span class="text-sm font-bold text-amber-400 capitalize block"><%= typeof project !== 'undefined' && project ? project.category : 'Real Estate' %></span>
                    </div>
                    <div class="bg-slate-900/80 p-4 rounded-xl border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-400 block uppercase font-bold">Status</span>
                        <span class="text-sm font-bold <%= typeof project !== 'undefined' && project && project.status === 'completed' ? 'text-emerald-400' : 'text-sky-400' %> capitalize block">
                            <%= typeof project !== 'undefined' && project && project.status === 'completed' ? 'Delivered' : 'Ongoing' %>
                        </span>
                    </div>
                    <div class="bg-slate-900/80 p-4 rounded-xl border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-400 block uppercase font-bold">Location</span>
                        <span class="text-sm font-bold text-white block"><%= typeof project !== 'undefined' && project ? project.location : 'Odisha' %></span>
                    </div>
                    <% if (typeof project !== 'undefined' && project && project.built_up_area) { %>
                        <div class="bg-slate-900/80 p-4 rounded-xl border border-slate-800 space-y-1">
                            <span class="text-[10px] text-slate-400 block uppercase font-bold">Scale / Built-Up Area</span>
                            <span class="text-sm font-bold text-white block"><%= project.built_up_area %></span>
                        </div>
                    <% } %>
                    <% if (typeof project !== 'undefined' && project && project.unit_types) { %>
                        <div class="bg-slate-900/80 p-4 rounded-xl border border-slate-800 space-y-1 sm:col-span-2">
                            <span class="text-[10px] text-slate-400 block uppercase font-bold">Configurations / Scope</span>
                            <span class="text-sm font-bold text-white block"><%= project.unit_types %></span>
                        </div>
                    <% } %>
                </div>

                <% if (typeof project !== 'undefined' && project && project.short_desc) { %>
                    <div class="pt-4 border-t border-slate-800/80">
                        <span class="text-[11px] text-slate-400 block uppercase font-bold mb-2">Description</span>
                        <p class="text-slate-200 text-sm leading-relaxed">
                            <%= project.short_desc %>
                        </p>
                    </div>
                <% } %>
            </div>

            <!-- ==========================================
                 VIDEO WALKTHROUGH & VIRTUAL TOUR SECTION
                 ========================================== -->
            <% 
                let videoEmbed = null;
                if (typeof project !== 'undefined' && project && project.video_url && project.video_url.trim() !== '') {
                    const rawUrl = project.video_url.trim();
                    const ytMatch = rawUrl.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
                    const vimeoMatch = rawUrl.match(/vimeo\.com\/(?:video\/)?([0-9]+)/);
                    
                    if (ytMatch) {
                        videoEmbed = { type: 'youtube', src: `https://www.youtube.com/embed/${ytMatch[1]}?rel=0&autoplay=0` };
                    } else if (vimeoMatch) {
                        videoEmbed = { type: 'vimeo', src: `https://player.vimeo.com/video/${vimeoMatch[1]}` };
                    } else {
                        videoEmbed = { type: 'video', src: rawUrl };
                    }
                }
            %>

            <% if (videoEmbed) { %>
                <div id="video-walkthrough-section" class="glass-card p-6 sm:p-8 space-y-6 scroll-mt-28 border-red-500/30">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-4">
                        <div>
                            <h2 class="text-2xl font-outfit font-bold text-white border-l-4 border-red-500 pl-3 flex items-center gap-2">
                                <span>Project Video Walkthrough</span>
                            </h2>
                            <p class="text-xs text-slate-400 mt-1">Watch cinematic drone footage, construction progress & virtual interior walkthrough.</p>
                        </div>
                        <span class="px-3 py-1 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-bold self-start sm:self-auto flex items-center gap-1.5">
                            <i class="fa-solid fa-play text-[10px]"></i> Virtual Tour
                        </span>
                    </div>

                    <!-- Video Player Container (16:9 Aspect Ratio) -->
                    <div class="relative w-full aspect-video rounded-2xl overflow-hidden bg-black border border-slate-800 shadow-2xl">
                        <% if (videoEmbed.type === 'youtube' || videoEmbed.type === 'vimeo') { %>
                            <iframe src="<%= videoEmbed.src %>" 
                                    class="w-full h-full border-0" 
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                                    allowfullscreen 
                                    title="<%= project.title %> Video Walkthrough">
                            </iframe>
                        <% } else { %>
                            <video controls class="w-full h-full object-contain bg-black" poster="<%= project.cover_image %>">
                                <source src="<%= videoEmbed.src %>" type="video/mp4">
                                <source src="<%= videoEmbed.src %>" type="video/webm">
                                Your browser does not support the video tag.
                            </video>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <!-- ==========================================
                 MULTI-PHOTO PROJECT GALLERY SECTION
                 ========================================== -->
            <% 
                let allPhotos = [];
                if (typeof project !== 'undefined' && project) {
                    if (project.cover_image && project.cover_image !== '/images/projects/default.jpg') {
                        allPhotos.push(project.cover_image);
                    }
                    if (Array.isArray(project.gallery_images)) {
                        project.gallery_images.forEach(img => {
                            if (img && !allPhotos.includes(img)) allPhotos.push(img);
                        });
                    }
                }
            %>

            <div class="glass-card p-6 sm:p-8 space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-4">
                    <div>
                        <h2 class="text-2xl font-outfit font-bold text-white border-l-4 border-amber-400 pl-3">
                            Project Photos & Gallery
                        </h2>
                        <p class="text-xs text-slate-400 mt-1">Click on any photo to view in high-resolution fullscreen.</p>
                    </div>
                    <span class="px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold self-start sm:self-auto">
                        <%= allPhotos.length %> <%= allPhotos.length === 1 ? 'Photo' : 'Photos' %>
                    </span>
                </div>

                <% if (allPhotos.length > 0) { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4" id="project-gallery-grid">
                        <% allPhotos.forEach((photoUrl, index) => { %>
                            <div class="group relative aspect-video rounded-2xl overflow-hidden bg-slate-900 border border-slate-800 cursor-pointer shadow-lg hover:border-amber-400/80 transition-all duration-300"
                                 onclick="openLightbox(<%= index %>)">
                                <img src="<%= photoUrl %>" alt="Project Photo <%= index + 1 %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-between p-4">
                                    <span class="text-xs font-semibold text-white">Photo <%= index + 1 %></span>
                                    <div class="w-8 h-8 rounded-full bg-amber-500 text-black flex items-center justify-center text-xs shadow-lg">
                                        <i class="fa-solid fa-expand"></i>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <!-- Fallback if no images uploaded yet -->
                    <div class="text-center py-12 bg-slate-900/40 rounded-2xl border border-slate-800 space-y-3">
                        <div class="w-16 h-16 rounded-full bg-slate-800 text-amber-400 mx-auto flex items-center justify-center text-2xl">
                            <i class="fa-solid fa-camera"></i>
                        </div>
                        <h3 class="text-base font-outfit font-bold text-white">Site Photos Under Archival</h3>
                        <p class="text-xs text-slate-400 max-w-sm mx-auto">High-resolution on-site photographs and blueprints for this project can be requested directly from our corporate desk.</p>
                    </div>
                <% } %>
            </div>

        </div>

        <!-- Right Column: Instant Project Inquiry Form -->
        <div class="space-y-6" id="inquire">
            <div class="glass-card-gold p-6 sm:p-8 space-y-6 sticky top-28">
                <div class="space-y-2">
                    <span class="text-[10px] font-bold uppercase tracking-widest text-amber-400">Direct Developer Inquiry</span>
                    <h3 class="text-2xl font-outfit font-black text-white">Book a Site Visit</h3>
                    <p class="text-xs text-slate-300">
                        Connect with ZIPTRON's official sales and engineering desk for pricing, floor plans & on-site scheduling.
                    </p>
                </div>

                <form action="/contact/submit" method="POST" class="space-y-4 text-xs">
                    <input type="hidden" name="service" value="<%= typeof project !== 'undefined' && project ? project.category : 'Real Estate' %>">
                    <input type="hidden" name="project_name" value="<%= typeof project !== 'undefined' && project ? project.title : 'General Project Inquiry' %>">
                    
                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Your Full Name*</label>
                        <input type="text" name="name" required placeholder="e.g. Soumya Jena" class="w-full px-3 py-2.5 rounded-lg bg-black/60 border border-slate-700 text-white focus:border-amber-400 focus:outline-none">
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Phone Number*</label>
                        <input type="tel" name="phone" required placeholder="e.g. +91 9337512111" class="w-full px-3 py-2.5 rounded-lg bg-black/60 border border-slate-700 text-white focus:border-amber-400 focus:outline-none">
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Email Address</label>
                        <input type="email" name="email" placeholder="name@example.com" class="w-full px-3 py-2.5 rounded-lg bg-black/60 border border-slate-700 text-white focus:border-amber-400 focus:outline-none">
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Inquiry / Requirements</label>
                        <textarea name="message" rows="3" placeholder="I would like to inquire about project schedule, pricing and site visits..." class="w-full px-3 py-2.5 rounded-lg bg-black/60 border border-slate-700 text-white focus:border-amber-400 focus:outline-none"></textarea>
                    </div>

                    <button type="submit" class="w-full btn-gold py-3 text-xs font-bold shadow-lg shadow-amber-500/20">
                        <span>Send Direct Inquiry</span>
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>

                <div class="pt-4 border-t border-amber-500/20 text-center space-y-2">
                    <span class="text-[11px] text-slate-400 block">Or call directly:</span>
                    <a href="tel:+919337512111" class="text-sm font-outfit font-bold text-amber-400 hover:underline block">+91 9337512111 / 7008757918</a>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- ==========================================
     FULLSCREEN PHOTO LIGHTBOX MODAL
     ========================================== -->
<div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/95 backdrop-blur-md hidden flex items-center justify-center p-4">
    <!-- Close Button -->
    <button onclick="closeLightbox()" class="absolute top-6 right-6 text-slate-400 hover:text-white text-3xl z-50 p-2 transition-colors">
        <i class="fa-solid fa-xmark"></i>
    </button>

    <!-- Prev Button -->
    <button onclick="prevLightboxImage()" class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-slate-900/80 hover:bg-amber-500 text-white hover:text-black border border-slate-700 flex items-center justify-center text-lg z-50 transition-all">
        <i class="fa-solid fa-chevron-left"></i>
    </button>

    <!-- Next Button -->
    <button onclick="nextLightboxImage()" class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-slate-900/80 hover:bg-amber-500 text-white hover:text-black border border-slate-700 flex items-center justify-center text-lg z-50 transition-all">
        <i class="fa-solid fa-chevron-right"></i>
    </button>

    <!-- Image Container -->
    <div class="max-w-5xl max-h-[85vh] flex flex-col items-center justify-center space-y-3">
        <img id="lightbox-img" src="" alt="Enlarged Project Photo" class="max-w-full max-h-[75vh] object-contain rounded-2xl border border-slate-800 shadow-2xl">
        <span id="lightbox-counter" class="text-xs text-slate-400 font-mono"></span>
    </div>
</div>

<script>
    const galleryPhotos = <%- JSON.stringify(allPhotos) %>;
    let currentPhotoIdx = 0;

    function openLightbox(index) {
        if (!galleryPhotos || galleryPhotos.length === 0) return;
        currentPhotoIdx = index;
        updateLightbox();
        document.getElementById('lightbox-modal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
        document.getElementById('lightbox-modal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    function updateLightbox() {
        document.getElementById('lightbox-img').src = galleryPhotos[currentPhotoIdx];
        document.getElementById('lightbox-counter').innerText = `Photo ${currentPhotoIdx + 1} of ${galleryPhotos.length}`;
    }

    function nextLightboxImage() {
        if (!galleryPhotos || galleryPhotos.length === 0) return;
        currentPhotoIdx = (currentPhotoIdx + 1) % galleryPhotos.length;
        updateLightbox();
    }

    function prevLightboxImage() {
        if (!galleryPhotos || galleryPhotos.length === 0) return;
        currentPhotoIdx = (currentPhotoIdx - 1 + galleryPhotos.length) % galleryPhotos.length;
        updateLightbox();
    }

    // Keyboard ESC & Arrow Navigation
    document.addEventListener('keydown', (e) => {
        const modal = document.getElementById('lightbox-modal');
        if (modal && !modal.classList.contains('hidden')) {
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowRight') nextLightboxImage();
            if (e.key === 'ArrowLeft') prevLightboxImage();
        }
    });
</script>
