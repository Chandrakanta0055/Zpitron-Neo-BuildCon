<!-- ==========================================
     PROJECTS HERO BANNER
     ========================================== -->
<section class="relative py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-[#05170A] via-[#0D1B2A] to-[#0D1B2A] border-b border-amber-500/10">
    <div class="max-w-5xl mx-auto text-center space-y-4">
        <div data-aos="fade-down" class="inline-flex items-center space-x-2 px-4 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-widest">
            <i class="fa-solid fa-city"></i>
            <span>Track Record & Portfolio</span>
        </div>
        <h1 data-aos="fade-up" class="text-3xl sm:text-5xl font-outfit font-black text-white">
            Projects & <span class="text-gold-gradient">Developments</span>
        </h1>
        <p data-aos="fade-up" data-aos-delay="100" class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto">
            Discover our active construction sites and successfully delivered infrastructure across Eastern India.
        </p>

        <!-- Quick Jump Section Buttons -->
        <div data-aos="fade-up" data-aos-delay="200" class="pt-4 flex flex-wrap items-center justify-center gap-3">
            <a href="#ongoing-section" class="px-5 py-2.5 rounded-full bg-sky-500/15 text-sky-400 border border-sky-500/40 text-xs font-bold hover:bg-sky-500/25 transition-all flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-sky-400 animate-ping"></span>
                <span>🔵 Ongoing Projects (<%= totalOngoing %> Active)</span>
            </a>
            <a href="#completed-section" class="px-5 py-2.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/40 text-xs font-bold hover:bg-emerald-500/25 transition-all flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                <span>🟢 Completed Projects (<%= totalCompleted %> Delivered)</span>
            </a>
        </div>
    </div>
</section>

<div class="bg-[#0D1B2A] py-12 px-4 sm:px-6 lg:px-8 space-y-20">
    <div class="max-w-7xl mx-auto space-y-20">

        <!-- ==========================================
             SECTION 1: ONGOING PROJECTS
             ========================================== -->
        <section id="ongoing-section" class="space-y-8 scroll-mt-28">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4 border-b border-sky-500/30">
                <div class="space-y-1">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 text-sky-400 border border-sky-500/30 text-xs font-bold">
                        <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
                        <span>ACTIVE CONSTRUCTION & SITES</span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-outfit font-black text-white">
                        Ongoing <span class="text-sky-400">Projects (<%= totalOngoing %>)</span>
                    </h2>
                </div>
                <p class="text-xs sm:text-sm text-slate-400 max-w-md">
                    Flagship residential, commercial, and mining operations currently under active engineering and construction.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% if (ongoingProjects && ongoingProjects.length > 0) { %>
                    <% ongoingProjects.forEach((project, idx) => { %>
                        <div class="glass-card overflow-hidden group border-sky-500/30 hover:border-sky-400 flex flex-col justify-between" data-aos="fade-up" data-aos-delay="<%= idx * 50 %>">
                            <div>
                                <!-- Clickable Thumbnail -->
                                <a href="/projects/<%= project.slug %>" class="block h-48 bg-gradient-to-br from-slate-900 via-[#102035] to-[#0D1B2A] relative overflow-hidden border-b border-slate-800 cursor-pointer">
                                    <% if (project.cover_image && project.cover_image !== '/images/projects/default.jpg') { %>
                                        <img src="<%= project.cover_image %>" alt="<%= project.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                    <% } else { %>
                                        <div class="w-full h-full flex items-center justify-center text-sky-500/30 text-6xl group-hover:scale-110 group-hover:text-sky-500/50 transition-all duration-500">
                                            <% if (project.category === 'mining') { %>
                                                <i class="fa-solid fa-truck-monster"></i>
                                            <% } else if (project.category === 'solar') { %>
                                                <i class="fa-solid fa-solar-panel"></i>
                                            <% } else if (project.category === 'construction') { %>
                                                <i class="fa-solid fa-trowel-bricks"></i>
                                            <% } else { %>
                                                <i class="fa-solid fa-city"></i>
                                            <% } %>
                                        </div>
                                    <% } %>

                                    <div class="absolute top-3 left-3">
                                        <span class="badge-ongoing"><span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-ping"></span> Ongoing</span>
                                    </div>
                                    <div class="absolute top-3 right-3">
                                        <span class="px-2.5 py-1 rounded-full bg-black/70 text-amber-400 text-[10px] font-bold border border-amber-500/30 uppercase">
                                            <%= project.category %>
                                        </span>
                                    </div>
                                    <div class="absolute bottom-3 left-3 flex items-center gap-1.5 text-xs text-amber-400 font-semibold bg-black/60 px-2.5 py-1 rounded-md backdrop-blur-sm">
                                        <i class="fa-solid fa-location-dot"></i>
                                        <span><%= project.location %></span>
                                    </div>
                                </a>

                                <div class="p-5 space-y-2.5">
                                    <h3 class="text-lg font-outfit font-bold text-white group-hover:text-amber-400 transition-colors">
                                        <a href="/projects/<%= project.slug %>"><%= project.title %></a>
                                    </h3>
                                    <% if (project.short_desc) { %>
                                        <p class="text-xs text-slate-300 leading-relaxed line-clamp-2">
                                            <%= project.short_desc %>
                                        </p>
                                    <% } %>
                                </div>
                            </div>
                            <div class="p-5 pt-0">
                                <div class="pt-3 border-t border-slate-800 flex items-center justify-between text-xs">
                                    <span class="text-slate-400"><%= project.built_up_area || project.unit_types || 'Turnkey EPC' %></span>
                                    <a href="/projects/<%= project.slug %>" class="text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1">Photos & Details <i class="fa-solid fa-angle-right"></i></a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p class="text-slate-400 text-sm">No ongoing projects currently listed.</p>
                <% } %>
            </div>
        </section>

        <!-- ==========================================
             SECTION 2: COMPLETED PROJECTS
             ========================================== -->
        <section id="completed-section" class="space-y-8 scroll-mt-28">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4 border-b border-emerald-500/30">
                <div class="space-y-1">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-xs font-bold">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        <span>DELIVERED & VERIFIED MILESTONES</span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-outfit font-black text-white">
                        Completed <span class="text-emerald-400">Projects (<%= totalCompleted %>)</span>
                    </h2>
                </div>
                <p class="text-xs sm:text-sm text-slate-400 max-w-md">
                    Successfully completed and operational developments delivered on-time across Eastern India.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% if (completedProjects && completedProjects.length > 0) { %>
                    <% completedProjects.forEach((project, idx) => { %>
                        <div class="glass-card overflow-hidden group border-emerald-500/30 hover:border-emerald-400 flex flex-col justify-between" data-aos="fade-up" data-aos-delay="<%= idx * 40 %>">
                            <div>
                                <!-- Clickable Thumbnail -->
                                <a href="/projects/<%= project.slug %>" class="block h-44 bg-gradient-to-br from-slate-900 via-[#0E2618] to-[#05170A] relative overflow-hidden border-b border-slate-800 cursor-pointer">
                                    <% if (project.cover_image && project.cover_image !== '/images/projects/default.jpg') { %>
                                        <img src="<%= project.cover_image %>" alt="<%= project.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                    <% } else { %>
                                        <div class="w-full h-full flex items-center justify-center text-emerald-500/30 text-5xl group-hover:scale-110 group-hover:text-emerald-500/50 transition-all duration-500">
                                            <% if (project.category === 'mining') { %>
                                                <i class="fa-solid fa-truck-monster"></i>
                                            <% } else if (project.category === 'solar') { %>
                                                <i class="fa-solid fa-solar-panel"></i>
                                            <% } else if (project.category === 'construction') { %>
                                                <i class="fa-solid fa-trowel-bricks"></i>
                                            <% } else { %>
                                                <i class="fa-solid fa-building-circle-check"></i>
                                            <% } %>
                                        </div>
                                    <% } %>

                                    <div class="absolute top-3 left-3">
                                        <span class="badge-completed"><i class="fa-solid fa-check text-[10px]"></i> Delivered</span>
                                    </div>
                                    <div class="absolute top-3 right-3">
                                        <span class="px-2.5 py-1 rounded-full bg-black/70 text-emerald-400 text-[10px] font-bold border border-emerald-500/30 uppercase">
                                            <%= project.category %>
                                        </span>
                                    </div>
                                    <div class="absolute bottom-3 left-3 flex items-center gap-1.5 text-xs text-slate-300 font-semibold bg-black/60 px-2 py-0.5 rounded backdrop-blur-sm">
                                        <i class="fa-solid fa-location-dot text-amber-400"></i>
                                        <span><%= project.location %></span>
                                    </div>
                                </a>

                                <div class="p-5 space-y-2">
                                    <h3 class="text-base font-outfit font-bold text-white group-hover:text-emerald-400 transition-colors">
                                        <a href="/projects/<%= project.slug %>"><%= project.title %></a>
                                    </h3>
                                    <% if (project.short_desc) { %>
                                        <p class="text-xs text-slate-300 leading-relaxed line-clamp-2">
                                            <%= project.short_desc %>
                                        </p>
                                    <% } %>
                                </div>
                            </div>
                            <div class="p-5 pt-0">
                                <div class="pt-3 border-t border-slate-800 flex items-center justify-between text-xs">
                                    <span class="text-emerald-400 font-semibold"><%= project.built_up_area || project.unit_types || 'Delivered' %></span>
                                    <a href="/projects/<%= project.slug %>" class="text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1">Photos & Details <i class="fa-solid fa-angle-right"></i></a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p class="text-slate-400 text-sm">No completed projects listed yet.</p>
                <% } %>
            </div>
        </section>

    </div>
</div>
