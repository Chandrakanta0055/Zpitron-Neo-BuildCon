<!-- ==========================================
     PROJECTS HERO BANNER & QUICK NAV
     ========================================== -->
<section class="relative py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-[#05170A] via-[#0D1B2A] to-[#0D1B2A] border-b border-amber-500/10">
    <div class="max-w-6xl mx-auto text-center space-y-5">
        <div data-aos="fade-down" class="inline-flex items-center space-x-2 px-4 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-widest">
            <i class="fa-solid fa-city"></i>
            <span>Enterprise Portfolio & Sector Directory</span>
        </div>
        <h1 data-aos="fade-up" class="text-3xl sm:text-5xl lg:text-6xl font-outfit font-black text-white">
            Projects & <span class="text-gold-gradient">Developments</span>
        </h1>
        <p data-aos="fade-up" data-aos-delay="100" class="text-slate-300 text-sm sm:text-base max-w-3xl mx-auto leading-relaxed">
            Explore our multi-sector operations across Odisha — categorized by Real Estate, Civil Construction, Mining & Transport, and Solar Energy.
        </p>

        <!-- Quick Jump Sector Navigation Pills -->
        <div data-aos="fade-up" data-aos-delay="200" class="pt-4 flex flex-wrap items-center justify-center gap-3">
            <a href="#sector-real-estate" class="px-4 py-2 rounded-xl bg-slate-900/90 text-amber-400 border border-amber-500/30 text-xs font-bold hover:bg-amber-500/20 hover:border-amber-400 transition-all flex items-center gap-2 shadow-lg">
                <span>🏠</span>
                <span>Real Estate</span>
            </a>
            <a href="#sector-construction" class="px-4 py-2 rounded-xl bg-slate-900/90 text-emerald-400 border border-emerald-500/30 text-xs font-bold hover:bg-emerald-500/20 hover:border-emerald-400 transition-all flex items-center gap-2 shadow-lg">
                <span>🏗️</span>
                <span>Construction</span>
            </a>
            <a href="#sector-mining" class="px-4 py-2 rounded-xl bg-slate-900/90 text-amber-400 border border-amber-500/30 text-xs font-bold hover:bg-amber-500/20 hover:border-amber-400 transition-all flex items-center gap-2 shadow-lg">
                <span>🪏🚚</span>
                <span>Mining & Transport</span>
            </a>
            <a href="#sector-solar" class="px-4 py-2 rounded-xl bg-slate-900/90 text-sky-400 border border-sky-500/30 text-xs font-bold hover:bg-sky-500/20 hover:border-sky-400 transition-all flex items-center gap-2 shadow-lg">
                <span>☀️</span>
                <span>Solar EPC</span>
            </a>
        </div>
    </div>
</section>

<!-- ==========================================
     MAIN PORTFOLIO SECTORS
     ========================================== -->
<div class="bg-[#0D1B2A] py-14 px-4 sm:px-6 lg:px-8 space-y-24">
    <div class="max-w-7xl mx-auto space-y-28">

        <% sectors.forEach((sector, sIdx) => { %>
            <% 
                const sectorProjects = allProjects.filter(p => p.category === sector.key);
                const completedList = sectorProjects.filter(p => p.status === 'completed');
                const ongoingList = sectorProjects.filter(p => p.status === 'ongoing');
                const upcomingList = sectorProjects.filter(p => p.status === 'upcoming');
            %>

            <!-- SECTOR CONTAINER -->
            <section id="sector-<%= sector.key %>" class="space-y-12 scroll-mt-24 p-6 sm:p-8 rounded-3xl bg-[#08121E]/90 border border-slate-800 shadow-2xl relative overflow-hidden">
                <!-- Ambient Sector Accent Background -->
                <div class="absolute -top-24 -right-24 w-96 h-96 bg-<%= sector.accentColor === 'amber' ? 'amber-500/5' : (sector.accentColor === 'emerald' ? 'emerald-500/5' : 'sky-500/5') %> rounded-full blur-3xl pointer-events-none"></div>

                <!-- Sector Title Header -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-800 relative z-10" data-aos="fade-up">
                    <div class="space-y-2">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-xs font-bold text-amber-400">
                            <span class="text-base"><%= sector.emoji %></span>
                            <span class="uppercase tracking-wider">CORE BUSINESS SECTOR</span>
                        </div>
                        <h2 class="text-2xl sm:text-4xl font-black font-outfit text-white flex items-center gap-3">
                            <span><%= sector.title %></span>
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-400 max-w-2xl">
                            <%= sector.description %>
                        </p>
                    </div>

                    <!-- Sector Quick Stats Pills -->
                    <div class="flex flex-wrap items-center gap-2 shrink-0 text-xs font-semibold">
                        <span class="px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
                            🟢 <%= completedList.length %> Completed
                        </span>
                        <span class="px-3 py-1.5 rounded-lg bg-sky-500/10 border border-sky-500/30 text-sky-400">
                            🔵 <%= ongoingList.length %> Ongoing
                        </span>
                        <span class="px-3 py-1.5 rounded-lg bg-purple-500/10 border border-purple-500/30 text-purple-400">
                            🟣 <%= upcomingList.length %> Upcoming
                        </span>
                    </div>
                </div>

                <!-- SUBSECTION 1: COMPLETED PROJECTS -->
                <div class="space-y-6 relative z-10" data-aos="fade-up">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
                        <h3 class="text-lg sm:text-xl font-bold font-outfit text-white flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                            <span>Completed Projects</span>
                            <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/30">(<%= completedList.length %>)</span>
                        </h3>
                    </div>

                    <% if (completedList.length > 0) { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <% completedList.forEach((project, idx) => { %>
                                <div class="glass-card overflow-hidden group border-emerald-500/30 hover:border-emerald-400 flex flex-col justify-between transition-all duration-300">
                                    <div>
                                        <!-- Clickable Thumbnail -->
                                        <a href="/projects/<%= project.slug %>" class="block h-48 bg-gradient-to-br from-slate-900 via-[#0E2618] to-[#05170A] relative overflow-hidden border-b border-slate-800 cursor-pointer">
                                            <% const cThumb = (project.cover_image && project.cover_image !== '/images/projects/default.jpg') ? project.cover_image : ((project.gallery_images && project.gallery_images.length > 0) ? project.gallery_images[0] : null); %>
                                            <% if (cThumb) { %>
                                                <img src="<%= cThumb %>" alt="<%= project.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                            <% } else { %>
                                                <div class="w-full h-full flex items-center justify-center text-emerald-500/30 text-5xl group-hover:scale-110 group-hover:text-emerald-500/50 transition-all duration-500">
                                                    <i class="fa-solid <%= sector.icon %>"></i>
                                                </div>
                                            <% } %>

                                            <div class="absolute top-3 left-3">
                                                <span class="badge-completed"><i class="fa-solid fa-check text-[10px]"></i> Delivered</span>
                                            </div>
                                            <div class="absolute top-3 right-3">
                                                <span class="px-2.5 py-1 rounded-full bg-black/70 text-emerald-400 text-[10px] font-bold border border-emerald-500/30 uppercase">
                                                    <%= project.category %>
                                                </span>
                                            </div>
                                            <div class="absolute bottom-3 left-3 flex items-center gap-1.5 text-xs text-slate-300 font-semibold bg-black/60 px-2 py-0.5 rounded backdrop-blur-sm">
                                                <i class="fa-solid fa-location-dot text-amber-400"></i>
                                                <span class="truncate max-w-[200px]"><%= project.location %></span>
                                            </div>
                                        </a>

                                        <div class="p-6">
                                            <h4 class="text-lg font-bold font-outfit text-white mb-2 group-hover:text-emerald-400 transition-colors">
                                                <a href="/projects/<%= project.slug %>"><%= project.title %></a>
                                            </h4>
                                            <p class="text-slate-400 text-xs line-clamp-2 mb-4">
                                                <%= project.short_desc %>
                                            </p>

                                            <!-- Mini Specs -->
                                            <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-300 bg-slate-900/60 p-2.5 rounded-xl border border-slate-800/80 mb-4">
                                                <div>
                                                    <span class="text-slate-500 block text-[10px]">Scale</span>
                                                    <span class="font-medium text-white truncate block"><%= project.built_up_area || 'Delivered Complete' %></span>
                                                </div>
                                                <div>
                                                    <span class="text-slate-500 block text-[10px]">Configurations</span>
                                                    <span class="font-medium text-emerald-400 truncate block"><%= project.unit_types || 'Turnkey Handover' %></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="px-6 pb-6 pt-2 border-t border-slate-800/80 flex items-center justify-between text-xs">
                                        <span class="text-slate-500"><i class="fa-solid fa-circle-check mr-1 text-emerald-400"></i> Verified Handover</span>
                                        <a href="/projects/<%= project.slug %>" class="text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1">Photos & Details <i class="fa-solid fa-angle-right"></i></a>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="p-6 rounded-2xl bg-slate-900/40 border border-slate-800/80 text-center space-y-1">
                            <p class="text-xs text-slate-400">No completed projects currently archived in this category.</p>
                        </div>
                    <% } %>
                </div>

                <!-- SUBSECTION 2: ONGOING PROJECTS -->
                <div class="space-y-6 relative z-10" data-aos="fade-up">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
                        <h3 class="text-lg sm:text-xl font-bold font-outfit text-white flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-ping"></span>
                            <span>Ongoing Projects</span>
                            <span class="text-xs font-mono text-sky-400 bg-sky-500/10 px-2 py-0.5 rounded-full border border-sky-500/30">(<%= ongoingList.length %>)</span>
                        </h3>
                    </div>

                    <% if (ongoingList.length > 0) { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <% ongoingList.forEach((project, idx) => { %>
                                <div class="glass-card overflow-hidden group border-sky-500/30 hover:border-sky-400 flex flex-col justify-between transition-all duration-300">
                                    <div>
                                        <!-- Clickable Thumbnail -->
                                        <a href="/projects/<%= project.slug %>" class="block h-48 bg-gradient-to-br from-slate-900 via-[#102035] to-[#0D1B2A] relative overflow-hidden border-b border-slate-800 cursor-pointer">
                                            <% const oThumb = (project.cover_image && project.cover_image !== '/images/projects/default.jpg') ? project.cover_image : ((project.gallery_images && project.gallery_images.length > 0) ? project.gallery_images[0] : null); %>
                                            <% if (oThumb) { %>
                                                <img src="<%= oThumb %>" alt="<%= project.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                            <% } else { %>
                                                <div class="w-full h-full flex items-center justify-center text-sky-500/30 text-5xl group-hover:scale-110 group-hover:text-sky-500/50 transition-all duration-500">
                                                    <i class="fa-solid <%= sector.icon %>"></i>
                                                </div>
                                            <% } %>

                                            <div class="absolute top-3 left-3">
                                                <span class="badge-ongoing"><span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-ping"></span> Ongoing</span>
                                            </div>
                                            <div class="absolute top-3 right-3">
                                                <span class="px-2.5 py-1 rounded-full bg-black/70 text-sky-400 text-[10px] font-bold border border-sky-500/30 uppercase">
                                                    <%= project.category %>
                                                </span>
                                            </div>
                                            <div class="absolute bottom-3 left-3 flex items-center gap-1.5 text-xs text-slate-300 font-semibold bg-black/60 px-2 py-0.5 rounded backdrop-blur-sm">
                                                <i class="fa-solid fa-location-dot text-amber-400"></i>
                                                <span class="truncate max-w-[200px]"><%= project.location %></span>
                                            </div>
                                        </a>

                                        <div class="p-6">
                                            <h4 class="text-lg font-bold font-outfit text-white mb-2 group-hover:text-sky-400 transition-colors">
                                                <a href="/projects/<%= project.slug %>"><%= project.title %></a>
                                            </h4>
                                            <p class="text-slate-400 text-xs line-clamp-2 mb-4">
                                                <%= project.short_desc %>
                                            </p>

                                            <!-- Mini Specs -->
                                            <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-300 bg-slate-900/60 p-2.5 rounded-xl border border-slate-800/80 mb-4">
                                                <div>
                                                    <span class="text-slate-500 block text-[10px]">Built-up Area</span>
                                                    <span class="font-medium text-white truncate block"><%= project.built_up_area || 'Active Site' %></span>
                                                </div>
                                                <div>
                                                    <span class="text-slate-500 block text-[10px]">Configurations</span>
                                                    <span class="font-medium text-sky-400 truncate block"><%= project.unit_types || 'In Progress' %></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="px-6 pb-6 pt-2 border-t border-slate-800/80 flex items-center justify-between text-xs">
                                        <span class="text-slate-500"><i class="fa-solid fa-clock mr-1 text-sky-400"></i> Active Engineering</span>
                                        <a href="/projects/<%= project.slug %>" class="text-sky-400 hover:text-sky-300 font-bold flex items-center gap-1">Details & Progress <i class="fa-solid fa-angle-right"></i></a>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="p-6 rounded-2xl bg-slate-900/40 border border-slate-800/80 text-center space-y-1">
                            <p class="text-xs text-slate-400">No active construction sites currently in progress for this category.</p>
                        </div>
                    <% } %>
                </div>

                <!-- SUBSECTION 3: UPCOMING PROJECTS -->
                <div class="space-y-6 relative z-10" data-aos="fade-up">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
                        <h3 class="text-lg sm:text-xl font-bold font-outfit text-white flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-purple-400 animate-pulse"></span>
                            <span>Upcoming Projects</span>
                            <span class="text-xs font-mono text-purple-400 bg-purple-500/10 px-2 py-0.5 rounded-full border border-purple-500/30">(<%= upcomingList.length %>)</span>
                        </h3>
                    </div>

                    <% if (upcomingList.length > 0) { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <% upcomingList.forEach((project, idx) => { %>
                                <div class="glass-card overflow-hidden group border-purple-500/30 hover:border-purple-400 flex flex-col justify-between transition-all duration-300">
                                    <div>
                                        <!-- Clickable Thumbnail -->
                                        <a href="/projects/<%= project.slug %>" class="block h-48 bg-gradient-to-br from-slate-900 via-[#1A0B2E] to-[#0D1B2A] relative overflow-hidden border-b border-slate-800 cursor-pointer">
                                            <% const uThumb = (project.cover_image && project.cover_image !== '/images/projects/default.jpg') ? project.cover_image : ((project.gallery_images && project.gallery_images.length > 0) ? project.gallery_images[0] : null); %>
                                            <% if (uThumb) { %>
                                                <img src="<%= uThumb %>" alt="<%= project.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                            <% } else { %>
                                                <div class="w-full h-full flex items-center justify-center text-purple-500/30 text-5xl group-hover:scale-110 group-hover:text-purple-500/50 transition-all duration-500">
                                                    <i class="fa-solid <%= sector.icon %>"></i>
                                                </div>
                                            <% } %>

                                            <div class="absolute top-3 left-3">
                                                <span class="px-2.5 py-1 rounded-full bg-purple-500/20 text-purple-300 text-[10px] font-bold border border-purple-500/40 flex items-center gap-1.5">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-pulse"></span>
                                                    <span>Upcoming Launch</span>
                                                </span>
                                            </div>
                                            <div class="absolute top-3 right-3">
                                                <span class="px-2.5 py-1 rounded-full bg-black/70 text-purple-300 text-[10px] font-bold border border-purple-500/30 uppercase">
                                                    <%= project.category %>
                                                </span>
                                            </div>
                                            <div class="absolute bottom-3 left-3 flex items-center gap-1.5 text-xs text-slate-300 font-semibold bg-black/60 px-2 py-0.5 rounded backdrop-blur-sm">
                                                <i class="fa-solid fa-location-dot text-purple-400"></i>
                                                <span class="truncate max-w-[200px]"><%= project.location %></span>
                                            </div>
                                        </a>

                                        <div class="p-6">
                                            <h4 class="text-lg font-bold font-outfit text-white mb-2 group-hover:text-purple-400 transition-colors">
                                                <a href="/projects/<%= project.slug %>"><%= project.title %></a>
                                            </h4>
                                            <p class="text-slate-400 text-xs line-clamp-2 mb-4">
                                                <%= project.short_desc %>
                                            </p>

                                            <!-- Mini Specs -->
                                            <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-300 bg-slate-900/60 p-2.5 rounded-xl border border-slate-800/80 mb-4">
                                                <div>
                                                    <span class="text-slate-500 block text-[10px]">Planned Scale</span>
                                                    <span class="font-medium text-white truncate block"><%= project.built_up_area || 'Phase Planning' %></span>
                                                </div>
                                                <div>
                                                    <span class="text-slate-500 block text-[10px]">Configurations</span>
                                                    <span class="font-medium text-purple-400 truncate block"><%= project.unit_types || 'Upcoming Scope' %></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="px-6 pb-6 pt-2 border-t border-slate-800/80 flex items-center justify-between text-xs">
                                        <span class="text-slate-500"><i class="fa-solid fa-calendar-plus mr-1 text-purple-400"></i> Planned Launch</span>
                                        <a href="/contact" class="text-purple-400 hover:text-purple-300 font-bold flex items-center gap-1">Pre-Book / Inquire <i class="fa-solid fa-angle-right"></i></a>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="p-6 rounded-2xl bg-slate-900/40 border border-slate-800/80 text-center space-y-1">
                            <p class="text-xs text-slate-400">No upcoming launches currently scheduled in this category. Contact our corporate desk for early investment inquiries.</p>
                        </div>
                    <% } %>
                </div>

            </section>
        <% }); %>

        <!-- Call to Action Banner -->
        <section class="p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-amber-500/10 via-[#0D1B2A] to-sky-500/10 border border-amber-500/30 text-center space-y-6" data-aos="zoom-in">
            <h3 class="text-2xl sm:text-4xl font-outfit font-black text-white">
                Looking to Build, Invest, or Partner in Odisha?
            </h3>
            <p class="text-slate-300 text-sm max-w-2xl mx-auto">
                Whether you need turnkey EPC construction, luxury duplex development, or large-scale mining logistics, ZIPTRON NEO BUILDCON delivers on time and within budget.
            </p>
            <div class="pt-2 flex flex-wrap items-center justify-center gap-4">
                <a href="/contact" class="btn-primary flex items-center gap-2">
                    <i class="fa-solid fa-phone"></i>
                    <span>Consult Our Project Desk</span>
                </a>
                <a href="https://wa.me/919337512111" target="_blank" class="px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-outfit font-bold text-sm transition-all flex items-center gap-2 shadow-lg shadow-emerald-500/20">
                    <i class="fa-brands fa-whatsapp text-base"></i>
                    <span>WhatsApp Direct</span>
                </a>
            </div>
        </section>

    </div>
</div>
