<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Admin Portal | ZIPTRON NEO BUILDCON' %></title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/logo/emblem.jpg">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            dark: '#0D1B2A',
                            forest: '#05170A',
                            gold: '#F5A623',
                            goldLight: '#ECC246',
                            goldDark: '#D4AF37',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        outfit: ['Outfit', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <!-- Admin Stylesheet -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/animations.css">
    
    <%- typeof style !== 'undefined' ? style : '' %>
</head>
<body class="bg-[#080F18] text-slate-100 font-sans antialiased min-h-screen flex flex-col lg:flex-row overflow-x-hidden">
    <!-- Desktop Admin Sidebar (lg+) -->
    <aside class="hidden lg:flex lg:flex-col lg:w-64 bg-[#0D1B2A] border-r border-amber-500/20 justify-between p-4 min-h-screen shrink-0 sticky top-0 h-screen z-30">
        <div>
            <!-- Brand Logo -->
            <a href="/admin/dashboard" class="flex items-center space-x-3 pb-6 border-b border-amber-500/20 mb-6">
                <img src="/images/logo/emblem.jpg" alt="Ziptron Logo" class="w-10 h-10 rounded-lg object-contain bg-black p-1 border border-amber-500/30">
                <div>
                    <span class="font-outfit font-black text-lg tracking-wider text-white">ZIPTRON</span>
                    <span class="block text-[10px] uppercase font-semibold tracking-widest text-amber-400">Admin CMS</span>
                </div>
            </a>
            
            <!-- Navigation Links -->
            <nav class="space-y-1.5">
                <a href="/admin/dashboard" class="flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all <%= typeof page !== 'undefined' && page === 'dashboard' ? 'bg-amber-500/20 text-amber-400 border border-amber-500/40 font-bold' : 'text-slate-400 hover:text-white hover:bg-slate-800/50' %>">
                    <i class="fa-solid fa-gauge w-5 text-center text-amber-400"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/admin/projects" class="flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all <%= typeof page !== 'undefined' && page === 'projects' ? 'bg-amber-500/20 text-amber-400 border border-amber-500/40 font-bold' : 'text-slate-400 hover:text-white hover:bg-slate-800/50' %>">
                    <i class="fa-solid fa-city w-5 text-center text-sky-400"></i>
                    <span>Manage Projects</span>
                </a>
                <a href="/admin/leads" class="flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all <%= typeof page !== 'undefined' && page === 'leads' ? 'bg-amber-500/20 text-amber-400 border border-amber-500/40 font-bold' : 'text-slate-400 hover:text-white hover:bg-slate-800/50' %>">
                    <i class="fa-solid fa-envelope-open-text w-5 text-center text-emerald-400"></i>
                    <span>Inquiry Inbox</span>
                </a>
                <a href="/admin/reviews" class="flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all <%= typeof page !== 'undefined' && page === 'reviews' ? 'bg-amber-500/20 text-amber-400 border border-amber-500/40 font-bold' : 'text-slate-400 hover:text-white hover:bg-slate-800/50' %>">
                    <i class="fa-solid fa-star w-5 text-center text-amber-400"></i>
                    <span>Client Reviews</span>
                </a>
                <a href="/admin/stats" class="flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all <%= typeof page !== 'undefined' && page === 'stats' ? 'bg-amber-500/20 text-amber-400 border border-amber-500/40 font-bold' : 'text-slate-400 hover:text-white hover:bg-slate-800/50' %>">
                    <i class="fa-solid fa-chart-simple w-5 text-center text-amber-300"></i>
                    <span>Live Stats & Settings</span>
                </a>
            </nav>
        </div>
        
        <!-- Admin Footer Info & Logout -->
        <div class="pt-4 border-t border-slate-800/80 space-y-3">
            <a href="/" target="_blank" class="flex items-center space-x-2 text-xs text-slate-400 hover:text-amber-400 transition-colors px-2 py-1">
                <i class="fa-solid fa-arrow-up-right-from-square text-[11px]"></i>
                <span>View Live Website</span>
            </a>
            <div class="flex items-center justify-between pt-2 px-2 py-1 bg-slate-900/60 rounded-xl border border-slate-800">
                <div class="flex items-center space-x-2.5">
                    <div class="w-8 h-8 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-xs border border-amber-500/30">
                        A
                    </div>
                    <div class="text-xs">
                        <p class="font-semibold text-white leading-tight">Admin User</p>
                        <p class="text-slate-400 text-[10px]">info@ziptron.co.in</p>
                    </div>
                </div>
                <a href="/admin/logout" title="Logout" class="text-slate-400 hover:text-red-400 transition-colors p-1.5 rounded-lg hover:bg-red-500/10">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- Mobile Off-Canvas Drawer (Slide-in) -->
    <div id="mobile-drawer-overlay" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden transition-opacity duration-300 opacity-0 lg:hidden" onclick="toggleMobileAdminMenu()"></div>
    
    <div id="mobile-drawer" class="fixed inset-y-0 left-0 w-72 max-w-[85vw] bg-[#0D1B2A] border-r border-amber-500/30 p-5 z-50 transform -translate-x-full transition-transform duration-300 ease-in-out lg:hidden flex flex-col justify-between overflow-y-auto">
        <div>
            <!-- Mobile Drawer Header -->
            <div class="flex items-center justify-between pb-5 border-b border-slate-800 mb-6">
                <div class="flex items-center space-x-3">
                    <img src="/images/logo/emblem.jpg" alt="Ziptron Logo" class="w-9 h-9 rounded-lg object-contain bg-black p-1 border border-amber-500/30">
                    <div>
                        <span class="font-outfit font-black text-base text-white">ZIPTRON</span>
                        <span class="block text-[9px] uppercase font-semibold text-amber-400">Admin Portal</span>
                    </div>
                </div>
                <button type="button" onclick="toggleMobileAdminMenu()" class="p-2 rounded-xl bg-slate-900 text-slate-400 hover:text-white border border-slate-800">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>

            <!-- Mobile Nav Links -->
            <nav class="space-y-2">
                <a href="/admin/dashboard" onclick="toggleMobileAdminMenu()" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition-all <%= typeof page !== 'undefined' && page === 'dashboard' ? 'bg-amber-500 text-black font-bold shadow-lg shadow-amber-500/20' : 'text-slate-300 hover:bg-slate-800/80' %>">
                    <i class="fa-solid fa-gauge w-5 text-center"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/admin/projects" onclick="toggleMobileAdminMenu()" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition-all <%= typeof page !== 'undefined' && page === 'projects' ? 'bg-amber-500 text-black font-bold shadow-lg shadow-amber-500/20' : 'text-slate-300 hover:bg-slate-800/80' %>">
                    <i class="fa-solid fa-city w-5 text-center"></i>
                    <span>Manage Projects</span>
                </a>
                <a href="/admin/leads" onclick="toggleMobileAdminMenu()" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition-all <%= typeof page !== 'undefined' && page === 'leads' ? 'bg-amber-500 text-black font-bold shadow-lg shadow-amber-500/20' : 'text-slate-300 hover:bg-slate-800/80' %>">
                    <i class="fa-solid fa-envelope-open-text w-5 text-center"></i>
                    <span>Inquiry Inbox</span>
                </a>
                <a href="/admin/reviews" onclick="toggleMobileAdminMenu()" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition-all <%= typeof page !== 'undefined' && page === 'reviews' ? 'bg-amber-500 text-black font-bold shadow-lg shadow-amber-500/20' : 'text-slate-300 hover:bg-slate-800/80' %>">
                    <i class="fa-solid fa-star w-5 text-center"></i>
                    <span>Client Reviews</span>
                </a>
                <a href="/admin/stats" onclick="toggleMobileAdminMenu()" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition-all <%= typeof page !== 'undefined' && page === 'stats' ? 'bg-amber-500 text-black font-bold shadow-lg shadow-amber-500/20' : 'text-slate-300 hover:bg-slate-800/80' %>">
                    <i class="fa-solid fa-chart-simple w-5 text-center"></i>
                    <span>Live Stats & Settings</span>
                </a>
            </nav>
        </div>

        <div class="pt-6 border-t border-slate-800 space-y-3">
            <a href="/" target="_blank" class="flex items-center justify-center space-x-2 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-xs text-amber-400 font-bold hover:bg-slate-800 transition-colors">
                <i class="fa-solid fa-arrow-up-right-from-square text-[11px]"></i>
                <span>View Public Website</span>
            </a>
            <a href="/admin/logout" class="flex items-center justify-center space-x-2 py-2.5 rounded-xl bg-red-500/15 border border-red-500/30 text-xs text-red-300 font-bold hover:bg-red-500/25 transition-colors">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span>Logout Admin</span>
            </a>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 w-full overflow-x-hidden">
        <!-- Topbar -->
        <header class="h-16 bg-[#0D1B2A]/90 backdrop-blur-md border-b border-amber-500/15 px-4 sm:px-6 lg:px-8 flex items-center justify-between sticky top-0 z-20">
            <div class="flex items-center gap-3">
                <!-- Hamburger Button for Mobile -->
                <button type="button" onclick="toggleMobileAdminMenu()" class="lg:hidden p-2.5 rounded-xl bg-slate-900 text-amber-400 border border-amber-500/30 hover:bg-amber-500/20 transition-all flex items-center justify-center shadow-md">
                    <i class="fa-solid fa-bars text-base"></i>
                </button>
                <div class="flex items-center gap-2 lg:hidden">
                    <img src="/images/logo/emblem.jpg" alt="Logo" class="w-7 h-7 rounded object-contain bg-black p-0.5 border border-amber-500/30">
                    <span class="font-outfit font-black text-sm text-white">ZIPTRON</span>
                </div>
                <h1 class="hidden lg:block text-lg font-outfit font-bold text-white"><%= typeof title !== 'undefined' ? title : 'Administration' %></h1>
            </div>

            <div class="flex items-center space-x-3">
                <span class="text-[11px] sm:text-xs px-2.5 sm:px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center gap-1.5 font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="hidden sm:inline">System</span> Live
                </span>
                <a href="/" target="_blank" class="hidden sm:flex items-center gap-1 text-xs text-slate-400 hover:text-amber-400 transition-colors px-2 py-1 rounded-lg bg-slate-900 border border-slate-800">
                    <i class="fa-solid fa-globe text-[11px]"></i>
                    <span>Site</span>
                </a>
            </div>
        </header>

        <!-- Main Body Content -->
        <main class="flex-1 p-4 sm:p-6 lg:p-8 overflow-y-auto w-full max-w-full min-w-0">
            <%- body %>
        </main>
    </div>

    <!-- Mobile Menu Script -->
    <script>
        function toggleMobileAdminMenu() {
            const overlay = document.getElementById('mobile-drawer-overlay');
            const drawer = document.getElementById('mobile-drawer');
            if (!overlay || !drawer) return;

            const isOpen = !drawer.classList.contains('-translate-x-full');
            if (isOpen) {
                drawer.classList.add('-translate-x-full');
                overlay.classList.remove('opacity-100');
                overlay.classList.add('opacity-0');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            } else {
                overlay.classList.remove('hidden');
                setTimeout(() => {
                    overlay.classList.remove('opacity-0');
                    overlay.classList.add('opacity-100');
                    drawer.classList.remove('-translate-x-full');
                }, 10);
            }
        }
    </script>

    <%- typeof script !== 'undefined' ? script : '' %>
</body>
</html>
